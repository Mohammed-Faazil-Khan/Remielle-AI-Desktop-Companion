# Copy this file to ".env" (same folder as app.py) and fill in your own values.
# Never commit ".env" to GitHub. Real environment variables (e.g. in a PyCharm run configuration) override this file.

# --- Brain (NVIDIA API) ---
NVIDIA_API_KEY=

# --- Spotify (developer.spotify.com > Dashboard > your app) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Optional tuning (remove the leading # to use) ---
# REMIELLE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# A second model to try if the first one is down or unavailable (check the id on build.nvidia.com first):
# REMIELLE_FALLBACK_MODEL=
# REMIELLE_MAX_TOKENS=400
# REMIELLE_LLM_TIMEOUT=30
# REMIELLE_DISABLE_THINKING=1
# REMIELLE_NATIVE_TOOLS=0

# Speech-to-text: "cpu" frees GPU memory for GPT-SoVITS (try this if replies are slow)
# WHISPER_DEVICE=cuda
# WHISPER_MODEL=small.en

# Text-to-speech (GPT-SoVITS)
# SOVITS_SAMPLE_STEPS=8
# REMIELLE_TTS_TIMEOUT=120

# --- Your phone and the app window (run Setup_App.bat once; it makes the certificate and the Start Menu entry) ---
# The one key that lets a phone (or a tunnel visitor) reach her. Setup_App.bat and Launch_Remielle.bat
# make it automatically the first time and keep it here. Never share it.
# REMIELLE_ACCESS_TOKEN=
# REMIELLE_PORT=8000            # the port her page, her voice and the phone link use
# REMIELLE_HOST=0.0.0.0         # 127.0.0.0 -> this computer only; 0.0.0.0 lets your phone in
# REMIELLE_HTTPS=               # empty = https whenever certs\remielle.pem exists; 0 forces http
# REMIELLE_MC_READY_SECONDS=150 # how long "Minecraft mode on" waits for the game and her bot

# --- Minecraft companion (run Setup_Minecraft.bat once, then start the game with Launch_Minecraft.bat) ---
# "Minecraft mode on" is the one switch that does all of that for you: game, bot and her own goals.
MC_OWNER=
# MC_SERVER_VERSION=1.21.11     # Paper server version (the setup script falls back to the newest 1.21.x)
# MC_PORT=25565
# MC_BOT_NAME=Remielle
# MC_CHAT_ALWAYS=0              # 1 = she answers ANY chat line, not only ones that contain her name
# MC_API_PORT=3100              # internal bot link, only reachable from this PC
# REMIELLE_GAME_PTT_KEY=f8      # hold this key anywhere to talk to her (needs: pip install pynput)
# REMIELLE_GAME_EVENTS=1        # she speaks up about danger, low health, finished jobs
# REMIELLE_GAME_ECHO_CHAT=1     # her spoken replies also appear in the in-game chat
# REMIELLE_GAME_MIN_GAP=6       # seconds between things she says unprompted
